<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/mainMenuFragment">

    <fragment
        android:id="@+id/mainMenuFragment"
        android:name="mobile.presentation.MainMenuFragment"
        tools:layout="@layout/fragment_main_menu">

        <action
            android:id="@+id/action_mainMenuFragment_to_stepOneFragment"
            app:destination="@id/stepOneFragment" />
        <action
            android:id="@+id/action_mainMenuFragment_to_historyFragment"
            app:destination="@id/historyFragment" />
    </fragment>

    <fragment
        android:id="@+id/historyFragment"
        android:name="mobile.presentation.HistoryFragment"
        tools:layout="@layout/fragment_history" />

    <fragment
        android:id="@+id/stepOneFragment"
        android:name="mobile.presentation.StepOneFragment"
        tools:layout="@layout/fragment_step_one">

        <action
            android:id="@+id/action_stepOne_to_stepTwo"
            app:destination="@id/stepTwoFragment" />
    </fragment>

    <fragment
        android:id="@+id/stepTwoFragment"
        android:name="mobile.presentation.StepTwoFragment"
        tools:layout="@layout/fragment_step_two">

        <action
            android:id="@+id/action_stepTwo_to_resultFragment"
            app:destination="@id/resultFragment" />
    </fragment>

    <fragment
        android:id="@+id/resultFragment"
        android:name="mobile.presentation.ResultFragment"
        tools:layout="@layout/fragment_result" />
</navigation>