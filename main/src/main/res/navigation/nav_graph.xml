<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/mainFragment">

    <fragment
        android:id="@+id/mainFragment"
        android:name="ci.nsu.mobile.main.ui.main.MainFragment"
        android:label="Расчёт вкладов">
        <action
            android:id="@+id/action_mainFragment_to_step1Fragment"
            app:destination="@id/step1Fragment" />
        <action
            android:id="@+id/action_mainFragment_to_historyFragment"
            app:destination="@id/historyFragment" />
    </fragment>

    <fragment
        android:id="@+id/step1Fragment"
        android:name="ci.nsu.mobile.main.ui.step1.Step1Fragment"
        android:label="Этап 1">
        <action
            android:id="@+id/action_step1Fragment_to_step2Fragment"
            app:destination="@id/step2Fragment" />
        <action
            android:id="@+id/action_step1Fragment_to_mainFragment"
            app:destination="@id/mainFragment"
            app:popUpTo="@id/mainFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/step2Fragment"
        android:name="ci.nsu.mobile.main.ui.step2.Step2Fragment"
        android:label="Этап 2">
        <action
            android:id="@+id/action_step2Fragment_to_resultFragment"
            app:destination="@id/resultFragment" />
        <action
            android:id="@+id/action_step2Fragment_to_step1Fragment"
            app:destination="@id/step1Fragment" />
    </fragment>

    <fragment
        android:id="@+id/resultFragment"
        android:name="ci.nsu.mobile.main.ui.result.ResultFragment"
        android:label="Результат">
        <action
            android:id="@+id/action_resultFragment_to_mainFragment"
            app:destination="@id/mainFragment"
            app:popUpTo="@id/mainFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/historyFragment"
        android:name="ci.nsu.mobile.main.ui.history.HistoryFragment"
        android:label="История расчётов">
        <action
            android:id="@+id/action_historyFragment_to_mainFragment"
            app:destination="@id/mainFragment"
            app:popUpTo="@id/mainFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_historyFragment_to_detailFragment"
            app:destination="@id/detailFragment" />
    </fragment>
    <fragment
        android:id="@+id/detailFragment"
        android:name="ci.nsu.mobile.main.ui.history.DetailFragment"
        android:label="Детали расчёта" />

</navigation>