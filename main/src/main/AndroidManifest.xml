<?xml version="1.0" encoding="utf-8"?>
<!-- Task_1: Удалён закомментированный блок с дублирующими declaration Activity,
     который вызывал "Manifest merge failed". Оставлены 2 Activity:
     - MainActivity2 (Fragment + ViewModel) — LAUNCHER
     - MainActivity3 (Compose) — второстепенная -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Draft">

        <activity
            android:name=".MainActivity2"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity3"
            android:exported="true"
            android:label="@string/title_activity_main3"
            android:theme="@style/Theme.Draft">
        </activity>

    </application>

</manifest>