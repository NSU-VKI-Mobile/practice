<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16.dp">

    <EditText android:id="@+id/etAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Стартовый взнос"
        android:inputType="numberDecimal"/>

    <EditText android:id="@+id/etMonths"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Срок вклада (мес)"
        android:inputType="number"
        android:layout_marginTop="8.dp"/>

    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20.dp">
        <Button android:id="@+id/btnToStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="В начало"/>
        <Button android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Далее"/>
    </LinearLayout>

</LinearLayout>